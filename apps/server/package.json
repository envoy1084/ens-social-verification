{
  "name": "@ens-social-verification/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env --conditions=workspace-source src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "build": "tsdown",
    "lint": "oxlint --deny-warnings .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@ens-social-verification/api": "workspace:*",
    "@ens-social-verification/application": "workspace:*",
    "@ens-social-verification/database": "workspace:*",
    "@ens-social-verification/protocol": "workspace:*",
    "@farcaster/auth-client": "catalog:",
    "effect": "catalog:",
    "viem": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "klarity": "catalog:",
    "oxlint": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
