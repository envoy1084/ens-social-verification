HOST=127.0.0.1
PORT=8080
ALCHEMY_API_KEY=
NODE_ENV=development
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://ens_social:YOUR_PASSWORD@localhost:5432/ens_social
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional fine-grained PAT for public profile/gist reads. No extra permissions required.
# Without this, public reads use the OAuth app credentials.
GITHUB_API_TOKEN=
GITHUB_REDIRECT_URI=http://localhost:8080/verification/github/callback
# 32 random bytes encoded as 64 lowercase hex characters. Encrypts short-lived OAuth tokens, not a signing key.
GITHUB_TOKEN_ENCRYPTION_KEY=
