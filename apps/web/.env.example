# Optional: enables WalletConnect wallets; injected browser wallets work without it.
VITE_WALLETCONNECT_PROJECT_ID=
# Optional public Sepolia ENS subgraph endpoint for suggestions and registration dates.
VITE_ENS_SUBGRAPH_URL=
# Development/preview proxy target, never exposed to browser code.
SERVER_URL=http://127.0.0.1:8080
