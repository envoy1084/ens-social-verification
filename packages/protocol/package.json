{
  "name": "@ens-social-verification/protocol",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "workspace-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "workspace-source": "./src/schema/index.ts",
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    },
    "./model": {
      "workspace-source": "./src/model/index.ts",
      "types": "./dist/model/index.d.ts",
      "default": "./dist/model/index.js"
    },
    "./dto": {
      "workspace-source": "./src/dto/index.ts",
      "types": "./dist/dto/index.d.ts",
      "default": "./dist/dto/index.js"
    },
    "./errors": {
      "workspace-source": "./src/errors/index.ts",
      "types": "./dist/errors/index.d.ts",
      "default": "./dist/errors/index.js"
    }
  },
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings ."
  },
  "dependencies": {
    "@ensforge/core": "catalog:",
    "effect": "catalog:",
    "viem": "catalog:"
  },
  "devDependencies": {
    "klarity": "catalog:",
    "oxlint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
