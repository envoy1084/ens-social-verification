{
  "name": "@ens-social-verification/application",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "workspace-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.build.json",
