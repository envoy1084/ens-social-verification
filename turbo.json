{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["tsconfig.json", "oxlint.config.ts"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"],
      "env": ["VITE_*"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "HOST",
        "PORT",
        "ALCHEMY_API_KEY",
        "PIMLICO_*",
        "DATABASE_URL",
        "APP_ORIGIN",
        "PUBLIC_SERVER_URL",
        "NODE_ENV",
        "GITHUB_*",
        "X_*",
        "DISCORD_*",
        "TELEGRAM_*",
        "OAUTH_*",
        "RESEND_API_KEY",
        "EMAIL_VERIFICATION_RECIPIENT",
        "VITE_*"
      ]
    },
    "lint": { "outputs": [] },
    "lint:fix": { "cache": false },
    "typecheck": { "dependsOn": ["^typecheck"], "outputs": [] },
    "test": { "dependsOn": ["^build"], "outputs": [] },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["DATABASE_URL"]
    },
    "test:watch": { "cache": false, "persistent": true },
    "clean": { "cache": false }
  }
}
