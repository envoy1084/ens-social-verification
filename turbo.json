{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["tsconfig.json", "oxlint.config.ts"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"],
      "env": ["VITE_*", "SERVER_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["HOST", "PORT", "ALCHEMY_API_KEY", "VITE_*", "SERVER_URL"]
    },
    "lint": { "outputs": [] },
    "lint:fix": { "cache": false },
    "typecheck": { "dependsOn": ["^typecheck"], "outputs": [] },
    "test": { "dependsOn": ["^build"], "outputs": [] },
    "test:watch": { "cache": false, "persistent": true },
    "clean": { "cache": false }
  }
}
